# Copy to .env for local development. Never commit .env.

POSTGRES_DB=knowledge_rag
POSTGRES_USER=knowledge_rag
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://knowledge_rag:change-me@localhost:5432/knowledge_rag
BENCHMARK_DATABASE_URL=

# Point this at a sanitized vault for development.
VAULT_PATH=./examples/sample-vault

# External model credentials are intentionally blank.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=

# The types of notes and paths to exclude from the RAG process. These are optional and can be left empty.
EXCLUDED_PATHS=[]
EXCLUDED_NOTE_TYPES=[]

# Ingestion settings for production. These are optional and can be left empty.
KNOWLEDGE_RAG_PRODUCTION_VAULT_PATH=
KNOWLEDGE_RAG_ENABLE_PRODUCTION_INGESTION=false
